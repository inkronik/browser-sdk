{
  "name": "@inkronik/browser-sdk",
  "version": "1.1.0",
  "description": "Privacy-first browser RUM, tracing, and product-event SDK for Inkronik.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun run build:clean && bun run build:js && bun run build:types",
    "build:clean": "bun scripts/clean.ts",
    "build:js": "bun build src/index.ts --root=src --outdir=dist --target=browser --format=esm --sourcemap=linked --reject-unresolved",
    "build:types": "bun tsc --project tsconfig.build.json",
    "check:format": "prettier --check .",
    "check:lint": "eslint src",
    "pack:check": "npm pack --dry-run",
    "release:version": "release-it --release-version --ci",
    "test": "bun test ./src",
    "typecheck": "bun tsc --noEmit --project tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inkronik/browser-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/inkronik/browser-sdk/issues"
  },
  "homepage": "https://github.com/inkronik/browser-sdk#readme",
  "keywords": [
    "inkronik",
    "browser",
    "observability",
    "rum",
    "telemetry",
    "tracing",
    "web-vitals",
    "monitoring",
    "sdk"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "12.0.0",
    "@types/bun": "1.3.11",
    "brace-expansion": "1.1.18",
    "eslint": "9.39.4",
    "eslint-config-codemask": "2.2.1",
    "ip-address": "10.4.0",
    "prettier": "3.8.1",
    "release-it": "21.0.1",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.3.14"
}
