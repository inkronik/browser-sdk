{
  "name": "@inkronik/browser-sdk",
  "version": "1.1.0",
  "description": "Privacy-first browser RUM, tracing, and product-event SDK for Inkronik.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "import": "./dist/next/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun run build:clean && bun run build:js && bun run build:types && bun run check:next",
    "build:clean": "bun scripts/clean.ts",
    "build:js": "bun build src/index.ts src/next/index.ts --root=src --outdir=dist --target=browser --format=esm --splitting --sourcemap=linked --reject-unresolved",
    "build:types": "bun tsc --project tsconfig.build.json",
    "check:format": "prettier --check .",
    "check:lint": "eslint src",
    "check:next": "node scripts/prepare-next-fixture.mjs && next build scripts/fixtures/next-app",
    "pack:check": "npm pack --dry-run",
    "release:version": "release-it --release-version --ci",
    "test": "bun test ./src",
    "typecheck": "bun tsc --noEmit --project tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inkronik/browser-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/inkronik/browser-sdk/issues"
  },
  "homepage": "https://github.com/inkronik/browser-sdk#readme",
  "keywords": [
    "inkronik",
    "browser",
    "observability",
    "rum",
    "telemetry",
    "tracing",
    "web-vitals",
    "monitoring",
    "sdk",
    "nextjs"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "12.0.0",
    "@types/bun": "1.4.0",
    "@types/react": "19.2.18",
    "brace-expansion": "5.0.9",
    "eslint": "10.9.1",
    "eslint-config-codemask": "2.2.1",
    "ip-address": "10.5.0",
    "next": "16.3.3",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "release-it": "21.0.2",
    "typescript": "5.9.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.1"
  },
  "packageManager": "bun@1.4.0"
}
